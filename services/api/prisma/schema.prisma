// 星辰纪念平台 · 主数据库 Schema
// 约定：模型名 PascalCase，表名 snake_case（@@map），字段 camelCase（本期保持 camelCase 列名以减少映射心智负担）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 天体类型（与 @star/astro-data 的 CelestialObjectType 对齐，DB 侧用大写枚举）
enum CelestialType {
  STAR
  GALAXY
  NEBULA
  CLUSTER
}

/// 纪念登记状态
enum RegistrationStatus {
  PENDING_REVIEW // 命中敏感词等待人工/机器复审
  ACTIVE         // 生效，公开纪念页可访问
  REJECTED       // 复审拒绝
}

/// 纪念场景（白名单，与 apps/web MemorialModal 的中文选项一一对应）
enum OccasionType {
  LOVE         // 情侣纪念
  BIRTHDAY     // 生日
  WEDDING      // 婚礼
  GRADUATION   // 毕业
  NEWBORN      // 宝宝出生
  PET_MEMORIAL // 宠物纪念
  IN_MEMORIAM  // 逝者纪念
  OTHER        // 其他
}

/// 证书生成状态（占位）
enum CertificateStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

/// 订单状态（占位）
enum OrderStatus {
  CREATED
  PAID
  CANCELLED
  REFUNDED
}

/// Agent 任务状态
enum AgentTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// 天体主表：字段对齐 @star/astro-data 的 CelestialObject，另加运营字段。
model CelestialObject {
  id               Int           @id @default(autoincrement())
  /// 稳定唯一标识，如 'HIP32349'
  objectUid        String        @unique
  type             CelestialType
  nameEn           String
  nameZh           String
  /// 别名快照（搜索用规范化版本在 celestial_name_alias）
  aliases          String[]      @default([])
  bayer            String?
  constellation    String
  constellationZh  String
  /// J2000 赤经（度，0-360）
  raDeg            Float
  /// J2000 赤纬（度，-90-90）
  decDeg           Float
  magnitude        Float
  distanceLy       Float?
  spectralType     String?
  /// 各星表交叉编号，如 {"hip":"32349","hd":"48915"}
  catalogIds       Json          @default("{}")
  isNamable        Boolean       @default(true)
  isFeatured       Boolean       @default(false)
  descriptionZh    String?
  /// 前端渲染优先级（大者先渲染/更醒目），运营可调
  renderPriority   Int           @default(0)
  /// 搜索加权（叠加在相关性得分上），运营可调
  searchPriority   Int           @default(0)
  /// 数据质量评分 0-100（坐标/星等/简介完整度）
  dataQualityScore Int           @default(0)
  /// 数据来源批次，如 'astro-data-seed-v1'、'hipparcos-import'
  sourceCatalog    String        @default("astro-data-seed-v1")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  nameAliases   CelestialNameAlias[]
  registrations MemorialRegistration[]

  @@index([isFeatured, magnitude])
  @@index([constellation])
  @@index([isNamable, searchPriority(sort: Desc)])
  @@map("celestial_object")
}

/// 天体别名表：DB 化搜索的基础。alias 原文 + aliasNorm 规范化（小写去变音，逻辑与 astro-data/search.ts 的 normalize 一致）。
model CelestialNameAlias {
  id        Int             @id @default(autoincrement())
  objectUid String
  object    CelestialObject @relation(fields: [objectUid], references: [objectUid], onDelete: Cascade)
  /// 别名原文，如 '天狼星' / 'Dog Star' / 'α CMa'
  alias     String
  /// 规范化别名（小写、trim、NFD 去拉丁变音），Phase 3 在此列建 pg_trgm GIN 索引
  aliasNorm String
  /// 语言标记：'zh' | 'en' | 'sci'（学名/编号）
  lang      String          @default("en")
  /// 来源：'name' | 'alias' | 'bayer' | 'catalog' | 'constellation'（与 StarSearchResult.matchedOn 对齐）
  source    String          @default("alias")
  createdAt DateTime        @default(now())

  @@unique([objectUid, aliasNorm, source])
  @@index([aliasNorm])
  @@map("celestial_name_alias")
}

/// 用户表（占位：本期不做鉴权，只保证外键落点存在）
model AppUser {
  id        String   @id @default(cuid())
  /// 微信小程序 openid（预留）
  wxOpenid  String?  @unique
  /// 微信 unionid（预留）
  wxUnionid String?  @unique
  email     String?  @unique
  phone     String?  @unique
  nickname  String?
  avatarUrl String?
  /// 'user' | 'admin'，本期不做 RBAC，仅存字符串
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations MemorialRegistration[]
  orders        Order[]

  @@map("app_user")
}

/// 纪念命名登记主表
model MemorialRegistration {
  id               String             @id @default(cuid())
  /// 对外纪念编号，形如 STAR-20260710-K7PX
  registrationNo   String             @unique
  starObjectUid    String
  star             CelestialObject    @relation(fields: [starObjectUid], references: [objectUid])
  /// 登记时刻的星体快照（nameZh/nameEn/raDeg/decDeg/constellationZh/magnitude 等），证书与纪念页以此为准
  starSnapshotJson Json
  /// 星星纪念名（1-40 个字符，按 Unicode 码点计）
  memorialName     String             @db.VarChar(64)
  occasionType     OccasionType
  /// 纪念日期（仅日期，无时区语义）
  memorialDate     DateTime?          @db.Date
  /// 想说的话（<=140 字符）
  blessingText     String?            @db.VarChar(280)
  /// 长篇故事文本（预留给纪念页，<=2000 字符）
  storyText        String?            @db.Text
  status           RegistrationStatus @default(ACTIVE)
  /// 公开纪念页短链 slug，形如 'm7k2xq9f4t3w'
  publicSlug       String             @unique
  ownerUserId      String?
  owner            AppUser?           @relation(fields: [ownerUserId], references: [id])
  /// 联系邮箱（隐私字段，任何对外接口不返回）
  contactEmail     String?
  /// 审核备注（复审拒绝原因等，内部字段）
  reviewNote       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  certificates CertificateRecord[]
  orders       Order[]
  agentTasks   AgentTask[]

  @@index([starObjectUid, status])
  @@index([ownerUserId])
  @@index([status, createdAt(sort: Desc)])
  @@map("memorial_registration")
}

/// 证书记录（占位：Phase 3 由 BullMQ worker 生成 PDF/PNG 后写 OSS）
model CertificateRecord {
  id              String               @id @default(cuid())
  registrationId  String
  registration    MemorialRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  status          CertificateStatus    @default(PENDING)
  /// 阿里云 OSS 对象 key，如 'certificates/2026/07/STAR-20260710-K7PX-v1.pdf'
  ossObjectKey    String?
  /// 模板版本号，证书模板迭代后可重出
  templateVersion String               @default("v1")
  error           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([registrationId, status])
  @@map("certificate_record")
}

/// 订单（占位：Phase 3 接支付）
model Order {
  id             String                @id @default(cuid())
  orderNo        String                @unique
  userId         String?
  user           AppUser?              @relation(fields: [userId], references: [id])
  registrationId String?
  registration   MemorialRegistration? @relation(fields: [registrationId], references: [id])
  /// 商品 SKU 码，如 'MEMORIAL_BASIC' | 'MEMORIAL_DELUXE'
  skuCode        String
  /// 金额，单位分（避免浮点）
  amountFen      Int
  currency       String                @default("CNY")
  status         OrderStatus           @default(CREATED)
  /// 支付渠道：'wxpay' | 'alipay'（预留）
  channel        String?
  paidAt         DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("order")
}

/// Agent 任务表：AI 技能编排的持久化载体（证书文案生成、星空故事撰写等）
model AgentTask {
  id             String                @id @default(cuid())
  /// 技能码，如 'certificate.copywriting' | 'story.generate'
  skillCode      String
  inputJson      Json
  outputJson     Json?
  status         AgentTaskStatus       @default(QUEUED)
  error          String?
  /// 已尝试次数（BullMQ 重试对齐）
  attempts       Int                   @default(0)
  registrationId String?
  registration   MemorialRegistration? @relation(fields: [registrationId], references: [id])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([skillCode, status])
  @@map("agent_task")
}
