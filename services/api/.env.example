# ===== services/api 环境变量（全部占位，勿填真实密钥） =====
# HTTP 端口（web 用 3000，api 默认 3001）
PORT=3001
# 允许的前端来源，逗号分隔
WEB_ORIGIN=http://localhost:3000
# PostgreSQL 连接串
DATABASE_URL=postgresql://star:star_password@localhost:5432/star_memorial?schema=public
# Redis（可选：不配置则 Redis 相关能力优雅降级）
REDIS_URL=redis://localhost:6379/0
# 阿里云 OSS（Phase 3 证书上传用，占位）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=star-memorial-placeholder
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
