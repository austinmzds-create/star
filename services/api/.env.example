# ===== services/api 环境变量（全部占位，勿填真实密钥） =====
# HTTP 端口（web 用 3000，api 默认 3001）
PORT=3001
# 允许的前端来源，逗号分隔
WEB_ORIGIN=http://localhost:3000
# PostgreSQL 连接串
DATABASE_URL=postgresql://star:star_password@localhost:5432/star_memorial?schema=public
# Redis（可选：不配置则 Redis 相关能力优雅降级）
REDIS_URL=redis://localhost:6379/0
# 阿里云 OSS（证书上传用，占位；四个 OSS_* 均为有效值时 auto 模式才用 OSS，否则本地磁盘）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=star-memorial-placeholder
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# ===== 证书资产存储 =====
# 存储驱动：auto(默认，配了有效 OSS 用 OSS 否则本地) | local | oss | dataurl
STORAGE_DRIVER=auto
# 本地存储根目录（相对 services/api 运行目录）
STORAGE_LOCAL_DIR=.local-storage
# 本地资产对外基址（拼 GET /api/assets/*）
STORAGE_PUBLIC_BASE_URL=http://localhost:3001
# OSS 签名 URL 有效期（秒）
ASSET_URL_TTL=900
# OSS_ENDPOINT 可选（自定义域名/内网 endpoint）
OSS_ENDPOINT=

# ===== Agent / LLM（可选：不配置则宇宙来信降级为模板生成） =====
# Anthropic API Key（缺省 → TemplateProvider 兜底，绝不崩）
ANTHROPIC_API_KEY=your-anthropic-api-key
# 创意文案模型（宇宙来信用；代码内硬编码常量 claude-sonnet-5，此项仅文档占位）
ANTHROPIC_MODEL=claude-sonnet-5

# ===== 后台审核（AdminModule）=====
# 后台共享令牌：请求头 x-admin-token 比对此值。未配置则所有 /api/admin/* 返回 503「后台未启用」。
ADMIN_API_TOKEN=change-me-admin-token
# 可选：置 1 则任何含祝福语/故事文本的登记先进 PENDING_REVIEW 人工复审（默认关闭=干净内容自动 ACTIVE）
REVIEW_ALL_FREETEXT=0

# ===== 订单与支付（OrdersModule）=====
# 支付服务商：mock（默认，本地/测试）| wechat | alipay。真实网关未配置凭证时自动降级 mock。
PAYMENT_PROVIDER=mock
# 微信支付 v3（占位，未全部有效则该 provider 不激活）
WXPAY_APP_ID=your-wx-appid
WXPAY_MCHID=your-wx-mchid
WXPAY_API_V3_KEY=your-apiv3-key
WXPAY_CERT_SERIAL=your-cert-serial
WXPAY_PRIVATE_KEY=your-merchant-private-key
WXPAY_NOTIFY_URL=https://your-domain/api/payments/notify/wechat
# 支付宝（占位）
ALIPAY_APP_ID=your-alipay-appid
ALIPAY_PRIVATE_KEY=your-alipay-private-key
ALIPAY_PUBLIC_KEY=alipay-public-key
ALIPAY_NOTIFY_URL=https://your-domain/api/payments/notify/alipay
