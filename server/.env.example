# 复制为 server/.env 后填写
DEBUG=true
# 本地日常测试保持 false,避免 SQL 明细刷屏拖慢接口;排查 ORM 时再打开。
SQL_ECHO=false
# 生产默认 false；若要保留管理员日常验收切角色，显式设 true，接口仍要求管理员登录态。
ENABLE_TEST_ROLE_SWITCHER=false
SECRET_KEY=please-generate-a-random-string

# 生产用 PostgreSQL(牟提供);本地开发不填则默认 sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/star
REDIS_URL=redis://localhost:6379/0

# 达人 H5 域名(已拍板)
H5_BASE_URL=https://task.jisheng.yun

# 管理员引导白名单:这些手机号登录即获得管理员身份(逗号分隔),请改成你的手机号
ADMIN_PHONES=13800000000

# 阿里云 OSS —— 配 endpoint+bucket 即启用;AK/SK 留空则匿名模式(仅公共读写 bucket)
# 例:OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com  OSS_BUCKET=your-bucket
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 传输加速(可选):远距离/跨地域用户直传大视频慢时开启。
# 步骤:① OSS 控制台 → 该 bucket → 传输加速 → 开启(约 ¥1.25/GB,按加速流量计费);
#      ② 这里置 OSS_ACCELERATE=true。未在控制台开启就置 true 会导致直传 403。
OSS_ACCELERATE=false
# OSS_ACCELERATE_ENDPOINT=oss-accelerate.aliyuncs.com   # 海外用户可改 oss-accelerate-overseas.aliyuncs.com

# 阿里云短信(达人H5验证码;AK/签名/模板三项全配齐才真发,否则验证码打到服务端日志)
# 模板变量必须是 ${code};SIGN_NAME 为已审核通过的短信签名名称
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 快递100(订阅式轨迹 + 实时查询;企业管理后台获取)
KD100_KEY=
KD100_CUSTOMER=
KD100_SECRET=
KD100_USERID=
KD100_CALLBACK_URL=https://task.jisheng.yun/api/webhooks/kd100

# 客户现有智能体平台(已拍板:达人信息 LLM 解析走这里,OpenAI 兼容接口)
AGENT_API_BASE=
AGENT_API_KEY=

# 巨量引擎开放平台(服务商资质,千川绑定 spike)
OCEANENGINE_APP_ID=
OCEANENGINE_SECRET=
OCEANENGINE_REDIRECT_URI=https://your-admin-domain.com/api/qianchuan/oauth/callback
OCEANENGINE_AUTH_URL=https://ad.oceanengine.com/openapi/audit/oauth.html
OCEANENGINE_TOKEN_URL=https://ad.oceanengine.com/open_api/oauth2/access_token/
OCEANENGINE_SCOPE=
# 达人合作自动同步/创建接口确认后再配置;未配置时系统只允许手动填写千川合作ID
OCEANENGINE_COOPERATION_SYNC_URL=
OCEANENGINE_ACCESS_TOKEN_MODE=query
OCEANENGINE_ACCESS_TOKEN_PARAM=access_token
OCEANENGINE_ACCESS_TOKEN_HEADER=Access-Token
