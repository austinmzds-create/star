# 复制为 server/.env 后填写
DEBUG=true
SECRET_KEY=please-generate-a-random-string

# 生产用 PostgreSQL(牟提供);本地开发不填则默认 sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/star
REDIS_URL=redis://localhost:6379/0

# 达人 H5 域名(已拍板)
H5_BASE_URL=https://task.jisheng.yun

# 阿里云 OSS —— 配 endpoint+bucket 即启用;AK/SK 留空则匿名模式(仅公共读写 bucket)
# 例:OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com  OSS_BUCKET=your-bucket
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 阿里云短信(达人H5验证码;AK/签名/模板三项全配齐才真发,否则验证码打到服务端日志)
# 模板变量必须是 ${code};SIGN_NAME 为已审核通过的短信签名名称
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 快递100(订阅式轨迹 + 实时查询;企业管理后台获取)
KD100_KEY=
KD100_CUSTOMER=
KD100_SECRET=
KD100_USERID=
KD100_CALLBACK_URL=https://task.jisheng.yun/api/webhooks/kd100

# 客户现有智能体平台(已拍板:达人信息 LLM 解析走这里,OpenAI 兼容接口)
AGENT_API_BASE=
AGENT_API_KEY=

# 巨量引擎开放平台(服务商资质,千川绑定 spike)
OCEANENGINE_APP_ID=
OCEANENGINE_SECRET=
