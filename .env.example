# ===== 星辰纪念平台 根环境变量样例（全部占位，勿填真实密钥） =====
# 各应用/服务另有更细的 .env.example（见 services/api/.env.example）。

# --- services/api ---
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://star:star_password@localhost:5432/star_memorial?schema=public
REDIS_URL=redis://localhost:6379/0

# --- 阿里云 OSS（Phase 3 证书上传用，占位） ---
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=star-memorial-placeholder
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# --- apps/web ---
# 基址只写到主机+端口（api.ts 的请求路径自带 /api 前缀），见 docs/deployment.md §4.1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
