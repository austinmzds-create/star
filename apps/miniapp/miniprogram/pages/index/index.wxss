.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 120rpx 56rpx 0;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  margin-top: 80rpx;
}

.brand {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: var(--gold);
}

.subtitle {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-dim);
  letter-spacing: 2rpx;
}

.actions {
  margin-top: 40rpx;
}

.scan {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
}

.divider {
  display: flex;
  align-items: center;
  color: var(--text-dim);
  font-size: 24rpx;
  margin: 48rpx 0;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--glass-border);
}

.divider text {
  padding: 0 24rpx;
}

.manual {
  display: flex;
  align-items: center;
  padding: 12rpx 12rpx 12rpx 28rpx;
  gap: 16rpx;
}

.input {
  flex: 1;
  height: 72rpx;
  color: var(--text-main);
  font-size: 28rpx;
}

.ph {
  color: var(--text-dim);
}

.enter {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--gold-soft);
}
