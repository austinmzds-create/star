.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 40rpx 0;
  box-sizing: border-box;
}

.center {
  padding: 240rpx 0;
}

.dim {
  color: var(--text-dim);
}

.topbar {
  text-align: center;
  margin-bottom: 20rpx;
}

.star-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--gold);
}

.target-line {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-dim);
}

.fallback-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--gold-soft);
}

/* 罗盘 */
.compass-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.compass {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  border: 2rpx solid var(--glass-border);
  background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 70%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: box-shadow 0.3s ease;
}

.compass.aligned {
  box-shadow: 0 0 60rpx rgba(244, 213, 141, 0.7);
  border-color: var(--gold);
}

.tick {
  position: absolute;
  font-size: 26rpx;
  color: var(--text-dim);
}

.tick.n { top: 16rpx; left: 50%; transform: translateX(-50%); color: var(--gold-soft); }
.tick.s { bottom: 16rpx; left: 50%; transform: translateX(-50%); }
.tick.e { right: 16rpx; top: 50%; transform: translateY(-50%); }
.tick.w { left: 16rpx; top: 50%; transform: translateY(-50%); }

.arrow {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.15s linear;
}

.arrow-head {
  position: absolute;
  top: 40rpx;
  width: 0;
  height: 0;
  border-left: 26rpx solid transparent;
  border-right: 26rpx solid transparent;
  border-bottom: 44rpx solid var(--gold);
}

.arrow-body {
  position: absolute;
  top: 84rpx;
  width: 8rpx;
  height: 180rpx;
  background: linear-gradient(180deg, var(--gold) 0%, rgba(244, 213, 141, 0.2) 100%);
  border-radius: 8rpx;
}

.found {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--gold);
}

.guide {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.headline {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-main);
}

.headline.gold {
  color: var(--gold);
}

.subhint {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--text-dim);
}

/* 兜底浮层 */
.overlay {
  margin-top: 120rpx;
  padding: 56rpx 44rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}

.ov-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--gold);
}

.ov-body {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-main);
}

.ov-static {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-dim);
}

.ov-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
}
